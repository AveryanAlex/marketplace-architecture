  "panels": [
    {
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "cinema-clickhouse"
      },
      "id": 1,
      "title": "Retention Cohort Heatmap \u00b7 first activity (UTC)",
      "type": "table",
      "description": "Rows: first activity date. Columns: exact return day D0\u2013D7. Future/incomplete days are blank, not 0. Business retention D1/D7 separately uses first VIEW_STARTED.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cinema-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT toString(metric_date) AS Cohort,\nmaxIf(value, dimension='0') AS `Day 0`,\nmaxIf(value, dimension='1') AS `Day 1`,\nmaxIf(value, dimension='2') AS `Day 2`,\nmaxIf(value, dimension='3') AS `Day 3`,\nmaxIf(value, dimension='4') AS `Day 4`,\nmaxIf(value, dimension='5') AS `Day 5`,\nmaxIf(value, dimension='6') AS `Day 6`,\nmaxIf(value, dimension='7') AS `Day 7`\nFROM cinema.daily_metrics\nWHERE metric_name='cohort_retention' AND $__dateFilter(metric_date)\nGROUP BY metric_date ORDER BY metric_date",
          "queryType": "table",
          "format": 1,
          "meta": {
            "builderOptions": {
              "queryType": "table",
              "mode": "list"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            }
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "noValue": "\u2014",
          "color": {
            "mode": "continuous-RdYlGr"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cohort"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          }
        ]
      }
    },
    {
