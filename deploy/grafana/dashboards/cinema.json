      },
      "id": 5,
      "title": "Top movies \u00b7 started views",
      "type": "barchart",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cinema-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT dimension AS movie, sum(value) AS views FROM cinema.daily_metrics WHERE metric_name='top_movie_views' AND $__dateFilter(metric_date) GROUP BY dimension ORDER BY views DESC, movie LIMIT 10",
          "queryType": "table",
          "format": 1,
          "meta": {
            "builderOptions": {
              "queryType": "table",
              "mode": "list"
            }
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "movie",
        "showValue": "always"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
