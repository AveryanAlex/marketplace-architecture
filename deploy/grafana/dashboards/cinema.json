      },
      "id": 6,
      "title": "Viewing retention D1 / D7 \u00b7 by first view cohort",
      "type": "table",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "cinema-clickhouse"
          },
          "editorType": "sql",
          "rawSql": "SELECT metric_date AS cohort, maxIf(value,metric_name='retention_d1') AS D1, maxIf(value,metric_name='retention_d7') AS D7 FROM cinema.daily_metrics WHERE metric_name IN ('retention_d1','retention_d7') AND $__dateFilter(metric_date) GROUP BY metric_date ORDER BY metric_date",
          "queryType": "table",
          "format": 1,
          "meta": {
            "builderOptions": {
              "queryType": "table",
              "mode": "list"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "\u2014"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cohort"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      }
