@startuml
left to right direction
skinparam shadowing false
skinparam rectangleRoundCorner 12
skinparam defaultFontName SansSerif
title Marketplace — модульный монолит

actor "USER / SELLER / ADMIN" as client
rectangle "Marketplace API\nPython 3.13 / FastAPI / Uvicorn\n\nauth · products · orders · promo_codes" as api #DDEEFF
database "PostgreSQL 17\nusers · refresh_tokens · products\norders · order_items · promo_codes\nuser_operations" as db #DFF5E4
rectangle "Alembic\nОдноразовый запуск миграций" as migrations #FFF2D9
artifact "OpenAPI 3.0.3\nКонтракт API" as contract
rectangle "OpenAPI Generator\nМаршруты + Pydantic DTO\nПри сборке Docker-образа" as codegen #EEE5FF

client --> api : HTTP / JSON + Bearer JWT
api --> db : asyncpg / SQLAlchemy\nОбщие ACID-транзакции
migrations --> db : Версионирование схемы
contract --> codegen
codegen --> api : Generated routers + DTO
@enduml
