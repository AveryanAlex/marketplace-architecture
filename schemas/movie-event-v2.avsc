{
  "type": "record",
  "name": "MovieEvent",
  "namespace": "cinema.events",
  "doc": "UTC user activity. Kafka key=user_id. UUID is immutable across retries.",
  "fields": [
    {
      "name": "event_id",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      }
    },
    {
      "name": "user_id",
      "type": "string"
    },
    {
      "name": "movie_id",
      "type": "string"
    },
    {
      "name": "event_type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "VIEW_STARTED",
          "VIEW_FINISHED",
          "VIEW_PAUSED",
          "VIEW_RESUMED",
          "LIKED",
          "SEARCHED"
        ]
      }
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "device_type",
      "type": {
        "type": "enum",
        "name": "DeviceType",
        "symbols": [
          "MOBILE",
          "DESKTOP",
          "TV",
          "TABLET"
        ]
      }
    },
    {
      "name": "session_id",
      "type": "string"
    },
    {
      "name": "progress_seconds",
      "type": [
        "null",
        "int"
      ],
      "default": null
    },
    {
      "name": "app_version",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Added in v2 with a default for backward/forward compatibility."
    }
  ]
}
